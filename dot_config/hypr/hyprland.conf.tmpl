# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua



$mainMod = SUPER
$terminal = ghostty
$fileManager = dolphin
$menu = hyprlauncher
$browser = zen-browser
$messenger = Telegram
$notes = obsidian obsidian://open?path={{ .chezmoi.homeDir }}/obsidian

general {
    gaps_in = 3
    gaps_out = 0
}

input {
    kb_layout = us,ru
    kb_options = grp:alt_shift_toggle
}

animations {
    enabled = true
    # Disable the workspace-switch animation (instant switch)
    animation = workspaces, 0
}

# Pin apps to workspaces (more reliable than the exec-once silent prefix)
windowrule = match:class com.mitchellh.ghostty, workspace 1
windowrule = match:class zen, workspace 2
windowrule = match:class obsidian, workspace 3
windowrule = match:class org.telegram.desktop, workspace 4

# Startup: terminal on workspace 1, browser on workspace 2, obsidian on workspace 3, telegram on workspace 4
exec-once = ~/.config/hypr/set-wallpaper.sh
exec-once = ~/.local/bin/yambar
exec-once = swaync
exec-once = [workspace 1 silent] $terminal -e ~/.local/bin/home-tmux.sh
exec-once = [workspace 2 silent] $browser
exec-once = [workspace 3 silent] $notes
exec-once = [workspace 4 silent] $messenger

bind = $mainMod, Q, exec, $terminal
bind = $mainMod, B, exec, $browser
bind = $mainMod, SPACE, exec, rofi -show drun

# Pick a new random wallpaper from ~/github/wallpapers
bind = $mainMod, 0, exec, ~/.config/hypr/set-wallpaper.sh

# Screenshots: copy to clipboard + save to ~/Pictures/Screenshots
bind = CTRL, 4, exec, ~/.local/bin/screenshot.sh area
bind = CTRL, 5, exec, ~/.local/bin/screenshot.sh screen
bind = $mainMod SHIFT, 5, exec, ~/.local/bin/screenshot.sh window
bind = , Print, exec, ~/.local/bin/screenshot.sh area

# Switch workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu