# Environment for vpn-daemon.service (systemd --user) — sourced via EnvironmentFile.
#
# Copy to ~/.config/snx-rs/vpn-daemon.env, fill in, and `chmod 600` it.
# Gateway/user/tunnel settings are NOT repeated here: the daemon reads them
# from vpn.conf. Anything set here overrides vpn.conf.

# Webhook that stores one-time codes forwarded from the Indeed Key app
# (indeed-key-parser server, GET /codes) and its Bearer token.
VPN_TOTP_URL=http://192.168.1.93:8090/codes
VPN_TOTP_TOKEN=change-me

# "account" label to pick from the /codes JSON.
VPN_TOTP_ACCOUNT=Alfa-Bank

# Do not use a code older than this many seconds (TOTP window).
#VPN_TOTP_MAX_AGE=60

# Which login prompt gets the password (1..N). For vpn_Indeed the gateway asks
# for the Indeed code first and the AD password second, hence 2.
#VPN_PASSWORD_FACTOR=2

# Domain (AD) password. VPN_PASSWORD is also accepted.
ALFA_PASSWORD='change-me'
